# Copy to .env and set a stable random secret before starting.
WEBUI_SECRET_KEY=
# CERN remote LLM virtual key (keep the real value in .env only).
REMOTE_LLM_API_KEY=
# CERN OIDC client registered for http://127.0.0.1:7869/redirect.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# TEMPORARY WORKAROUND: ML-scoped session cookie header, copied from browser.
# Value format: authservice_session=<cookie value> (no Cookie: prefix).
# Expiring credential; never commit the real value. Renew after ML sign-in.
CERN_ML_SESSION_COOKIE=
# Encrypted OpenWebUI -> remote cluster gateway registration; scripts/register-toolhive.py fills this.
TOOLHIVE_OAUTH_CLIENT_INFO=
